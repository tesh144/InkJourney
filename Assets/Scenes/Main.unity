  m_Script: {fileID: 11500000, guid: e244298f9f6da4c5ea9449f1f9fc7ee6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  charDelay: 0.025
  promptColor: {r: 0.99215686, g: 0.66618955, b: 0, a: 1}
  taggedPrompts:
  - text: Describe something you can see from where you're standing right now.
    tags:
    - personal
  - text: What would this street look like in 100 years?
    tags:
    - creative_writing
    - history
  - text: Describe the sounds around you as if writing a film scene.
    tags:
    - creative_writing
  - text: What secret might this place be hiding?
    tags:
    - secret_spots
    - spooky
  - text: Write a letter to the next person who will stand exactly where you are.
    tags:
    - personal
  - text: What happened here at midnight last night?
    tags:
    - spooky
    - creative_writing
  - text: You find something unexpected on the ground. What is it?
    tags:
    - creative_writing
  - text: Write the opening line of a novel set right here.
    tags:
    - creative_writing
  - text: Describe this place to someone who has never left their hometown.
    tags:
    - personal
  - text: If this street could talk, what would it say?
    tags:
    - creative_writing
    - history
  - text: Name three things you can smell, hear, and feel right now.
    tags:
    - personal
  - text: Describe the light. What time of day does it feel like, even if you know
      the answer?
    tags:
    - creative_writing
  - text: What is the oldest thing you can see from here?
    tags:
    - history
    - architecture
  - text: What does the sky look like above you right now?
    tags:
    - nature
  - text: Write a weather report for the mood of this place.
    tags:
    - creative_writing
  - text: If this location were a character in a story, what would their personality
      be?
    tags:
    - creative_writing
  - text: What would a tourist notice here that you no longer see?
    tags:
    - secret_spots
    - nostalgia
  - text: Describe the ground beneath your feet in as much detail as possible.
    tags:
    - nature
  - text: What has been built over, paved over, or forgotten here?
    tags:
    - history
    - architecture
  - text: Who else is nearby? Invent their story in two sentences.
    tags:
    - creative_writing
    - funny
  - text: Write about a memory this place brings up.
    tags:
    - personal
    - nostalgia
  - text: How are you feeling right now, standing here?
    tags:
    - personal
  - text: What does this place mean to you and only you?
    tags:
    - personal
  - text: Write about someone you're thinking about right now.
    tags:
    - personal
  - text: What brought you here today, really?
    tags:
    - personal
  - text: Describe this moment as if you're looking back on it in ten years.
    tags:
    - personal
    - nostalgia
  - text: What were you worried about this time last year?
    tags:
    - personal
    - nostalgia
  - text: Write the last thing someone said to you that you can't stop thinking about.
    tags:
    - personal
  - text: Describe a place from your childhood that felt like this one.
    tags:
    - nostalgia
    - personal
  - text: What do you wish you'd said to someone?
    tags:
    - personal
  - text: Write about a decision that led you here.
    tags:
    - personal
  - text: What habit are you trying to build or break right now?
    tags:
    - personal
  - text: Describe a version of yourself that no longer exists.
    tags:
    - personal
    - nostalgia
  - text: What are you looking forward to?
    tags:
    - personal
  - text: Write about something you recently changed your mind about.
    tags:
    - personal
  - text: A stranger hands you an envelope with your name on it. What's inside?
    tags:
    - creative_writing
  - text: Write the first paragraph of a ghost story set exactly here.
    tags:
    - spooky
    - creative_writing
  - text: Someone has been watching this spot for years. Who are they?
    tags:
    - spooky
    - creative_writing
  - text: This place holds a door that only appears at a certain time. When, and
      where does it lead?
    tags:
    - creative_writing
    - spooky
  - text: Write a story in exactly five sentences that begins and ends here.
    tags:
    - creative_writing
  - text: A time traveller arrives here from 200 years ago. What shocks them most?
    tags:
    - history
    - creative_writing
  - text: Something is buried nearby. What is it, and who left it?
    tags:
    - spooky
    - secret_spots
  - text: Two people meet here by accident and it changes both their lives. What
      happens?
    tags:
    - creative_writing
  - text: Write about the last person to stand exactly where you are.
    tags:
    - creative_writing
    - history
  - text: What crime was committed here that was never solved?
    tags:
    - spooky
    - history
  - text: Describe this place as it appears in someone's recurring dream.
    tags:
    - creative_writing
    - spooky
  - text: A child growing up here would have one strange belief about this spot.
      What is it?
    tags:
    - creative_writing
  - text: Write three sentences. Make the last one surprising.
    tags:
    - creative_writing
  - text: 'Start with the words: ''Nobody knows that here...'''
    tags:
    - secret_spots
  - text: 'Start with the words: ''I used to think...'''
    tags:
    - personal
    - nostalgia
  - text: 'Start with the words: ''The last time I was somewhere like this...'''
    tags:
    - nostalgia
    - personal
  - text: Write something true that sounds like fiction.
    tags:
    - creative_writing
  - text: Write something fictional that sounds completely true.
    tags:
    - creative_writing
  - text: Describe this place using only questions.
    tags:
    - creative_writing
  - text: Write about something ending.
    tags:
    - personal
  - text: Write about something beginning.
    tags:
    - personal
  - text: "Describe something visually striking about where you're standing \u2014
      colour, shape, contrast."
    tags:
    - art
  - text: If a painter chose this spot as their subject, what would they focus on?
    tags:
    - art
    - creative_writing
  - text: Is there street art, graffiti, or a public sculpture nearby? What does
      it say about this place?
    tags:
    - art
    - secret_spots
  - text: Describe the colours of this moment as if naming paint shades.
    tags:
    - art
  - text: What would this scene look like as a photograph? Where would you point
      the camera?
    tags:
    - art
  - text: What song would play if this moment were in a film?
    tags:
    - music
    - creative_writing
  - text: Is there a busker, music, or sound nearby? Describe it.
    tags:
    - music
  - text: "What does the rhythm of this street feel like \u2014 fast, slow, chaotic,
      steady?"
    tags:
    - music
  - text: Write a single lyric that captures right now.
    tags:
    - music
    - creative_writing
  - text: Name a song that reminds you of a place like this. Why?
    tags:
    - music
    - nostalgia
  - text: Stage this location as a scene. Who enters? What do they want?
    tags:
    - theatre
    - creative_writing
  - text: Write the stage directions for the moment you're in right now.
    tags:
    - theatre
    - creative_writing
  - text: If this place were a theatre, what kind of stories would it stage?
    tags:
    - theatre
    - creative_writing
  - text: Who is the most interesting person you can see? Write their monologue.
    tags:
    - theatre
    - funny
  - text: What is the dramatic tension in this street right now?
    tags:
    - theatre
