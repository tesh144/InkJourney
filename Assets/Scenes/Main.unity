  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "On a moonless night at Russia Dock, the abandoned warehouses and rusted
    cranes became a stage for unspeakable horrors. Alex, a daring urban explorer,
    had heard whispers of restless souls and set out to uncover the truth. \nThe
    air was unnaturally still as he stepped onto creaking planks that groaned under
    each careful step.\n\r\rA dense fog clung to the water, swallowing the dock in
    a shroud of darkness. In the distance, a mournful echo\u2014like the lament of
    lost souls\u2014seemed to drift over the tide. \nDrawn to an old boathouse, Alex
    discovered remnants of a past filled with sorrow: faded photographs, scattered
    tools, and a heavy sense of despair that pulsed like a heartbeat. Then, without
    warning, the silence shattered. Footsteps\u2014heavy, deliberate\u2014approached
    from behind, though no one was visible. The temperature plummeted as a spectral
    figure emerged: a dockworker, his eyes hollow and voice a mere whisper of anguish,
    beckoning for escape from an eternal prison of regret.\r\r\nTrapped between terror
    and fascination, Alex realized that Russia Dock was more than decaying structures\u2014it
    was a tomb of memories, haunted by those doomed to linger in perpetual twilight.
    \nAs the ghost reached out, the chill of the night became a binding darkness,
    ensuring that some secrets were meant to remain buried in the deep, haunted echoes
    of the dock."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 44c166ea36dd349c58c8f0618fc95b60, type: 2}
  m_sharedMaterial: {fileID: 9152884653544851056, guid: 44c166ea36dd349c58c8f0618fc95b60, type: 2}
