rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Stories and Landmarks — public read, authenticated write
    match /Stories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /Landmarks/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles — any authenticated user can read/write
    // (App uses device-based IDs, not Firebase Auth UIDs, so uid == userId cannot be enforced)
    match /UserProfiles/{userId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Support tickets — authenticated write, no public read
    match /support_tickets/{id} {
      allow read, write: if request.auth != null;
    }

    // Friend requests — authenticated users can send and manage their own requests
    match /FriendRequests/{id} {
      allow read, write: if request.auth != null;
    }

    // Friends subcollection — authenticated users can read/write
    match /UserProfiles/{userId}/friends/{friendId} {
      allow read, write: if request.auth != null;
    }

    // Story read events — written by clients to trigger notifications.
    // Cloud Functions read/write via admin SDK (bypasses these rules).
    match /StoryReads/{id} {
      allow read:   if false;
      allow create: if true;
      allow update: if true;
    }
  }
}